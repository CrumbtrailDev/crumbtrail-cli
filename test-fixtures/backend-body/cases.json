{
  "$comment": "Structured backend body policy. Normative for every Crumbtrail SDK that captures a request or response body: the Ruby, Go and ASP.NET Core packages each run this file and must agree on it. Changing a case therefore fails all three at once, which is the point: three hand written copies of the same policy drifted apart on day one.",
  "policy": "crumbtrail.backend-redaction.v1",
  "limits": {
    "bytes": 16384,
    "nesting": 8,
    "keys": 64,
    "items": 40,
    "integerDigits": 6,
    "safeInteger": 9007199254740991
  },
  "states": {
    "captured": "Parsed and nothing was withheld.",
    "redacted": "Parsed and at least one value was withheld.",
    "invalid": "Malformed, ambiguous or structurally excessive.",
    "truncated": "Larger than the byte limit, or known to be incomplete.",
    "missing": "There was no body to capture."
  },
  "notes": [
    "A denied name is redacted whole and the subtree under it is never inspected, so an odd field inside a secret cannot decide the whole body is invalid.",
    "Ruby and Go reject duplicate keys anywhere in the document because their parsers see them; .NET does not see duplicates inside a subtree it has already redacted. That is the one place the three answers differ, and no case here depends on it."
  ],
  "cases": [
    {
      "name": "safe_operands",
      "why": "Bounded numbers, booleans, null, short enums and ISO currency codes are the operands an agent reasons with.",
      "input": "{\"amount\":18.75,\"entityId\":731,\"currency\":\"CAD\",\"ok\":true,\"note\":null}",
      "state": "captured",
      "body": {
        "amount": 18.75,
        "entityId": 731,
        "currency": "CAD",
        "ok": true,
        "note": null
      }
    },
    {
      "name": "sensitive_key_redacted",
      "why": "A denied name is dropped and the shape around it is kept.",
      "input": "{\"amount\":12,\"password\":\"do-not-capture\"}",
      "state": "redacted",
      "body": {
        "amount": 12,
        "password": "[REDACTED]"
      }
    },
    {
      "name": "sensitive_subtree_not_walked",
      "why": "The subtree under a denied name is never inspected, so an odd field inside a secret cannot decide the whole body is invalid.",
      "input": "{\"password\":{\"a-b\":1}}",
      "state": "redacted",
      "body": {
        "password": "[REDACTED]"
      }
    },
    {
      "name": "sensitive_array_redacted_whole",
      "why": "A denied name covers the array, not each element separately.",
      "input": "{\"tokens\":[\"red\",\"blue\"]}",
      "state": "redacted",
      "body": {
        "tokens": "[REDACTED]"
      }
    },
    {
      "name": "free_text_withheld",
      "why": "Free text carries whatever the user typed.",
      "input": "{\"note\":\"hello world\"}",
      "state": "redacted",
      "body": {
        "note": "[REDACTED]"
      }
    },
    {
      "name": "token_shape_withheld",
      "why": "A credential shape is withheld even under an innocent name.",
      "input": "{\"note\":\"sk_live_abcdefghijklmno\"}",
      "state": "redacted",
      "body": {
        "note": "[REDACTED]"
      }
    },
    {
      "name": "card_number_withheld",
      "why": "Sixteen digits is far past the digit cap.",
      "input": "{\"id\":4111111111111111}",
      "state": "redacted",
      "body": {
        "id": "[REDACTED]"
      }
    },
    {
      "name": "card_across_decimal",
      "why": "A card split by a decimal point keeps a short integer part, so the Luhn check is what catches it.",
      "input": "{\"ratio\":411111.1111111111}",
      "state": "redacted",
      "body": {
        "ratio": "[REDACTED]"
      }
    },
    {
      "name": "phone_number_withheld",
      "why": "Ten digits reaches phone length.",
      "input": "{\"mobile\":4165551234}",
      "state": "redacted",
      "body": {
        "mobile": "[REDACTED]"
      }
    },
    {
      "name": "phone_string_withheld",
      "why": "The same number as a string.",
      "input": "{\"contact\":\"4165551234\"}",
      "state": "redacted",
      "body": {
        "contact": "[REDACTED]"
      }
    },
    {
      "name": "identifier_withheld",
      "why": "Nine digits reaches national identifier length.",
      "input": "{\"identifier\":123456789}",
      "state": "redacted",
      "body": {
        "identifier": "[REDACTED]"
      }
    },
    {
      "name": "city_withheld",
      "why": "A city name locates a person.",
      "input": "{\"city\":\"toronto\"}",
      "state": "redacted",
      "body": {
        "city": "[REDACTED]"
      }
    },
    {
      "name": "diagnosis_withheld",
      "why": "A diagnosis is the most sensitive thing a body can carry.",
      "input": "{\"diagnosis\":\"cancer\"}",
      "state": "redacted",
      "body": {
        "diagnosis": "[REDACTED]"
      }
    },
    {
      "name": "short_denied_word_is_not_a_substring",
      "why": "\"capacity\" contains \"city\" and \"page\" contains \"age\". Neither is sensitive.",
      "input": "{\"capacity\":50,\"page\":3,\"pageSize\":25}",
      "state": "captured",
      "body": {
        "capacity": 50,
        "page": 3,
        "pageSize": 25
      }
    },
    {
      "name": "mixed_body",
      "why": "The request body the Rack, net/http and ASP.NET Core tests all send.",
      "input": "{\"amount\":18.75,\"email\":\"x@example.com\",\"routing_number\":123,\"note\":\"hello world\",\"id\":4111111111111111}",
      "state": "redacted",
      "body": {
        "amount": 18.75,
        "email": "[REDACTED]",
        "routing_number": "[REDACTED]",
        "note": "[REDACTED]",
        "id": "[REDACTED]"
      }
    },
    {
      "name": "digit_cap_boundary",
      "why": "Six digits is kept, seven is not.",
      "input": "{\"a\":999999,\"b\":1000000}",
      "state": "redacted",
      "body": {
        "a": 999999,
        "b": "[REDACTED]"
      }
    },
    {
      "name": "currency_code",
      "why": "Exactly three uppercase letters is a currency unit.",
      "input": "{\"currency\":\"CAD\"}",
      "state": "captured",
      "body": {
        "currency": "CAD"
      }
    },
    {
      "name": "uppercase_word_withheld",
      "why": "Four uppercase letters is not a currency unit.",
      "input": "{\"code\":\"ABCD\"}",
      "state": "redacted",
      "body": {
        "code": "[REDACTED]"
      }
    },
    {
      "name": "duplicate_key_invalid",
      "why": "An ambiguous object loses an operand whichever value wins.",
      "input": "{\"a\":1,\"a\":2}",
      "state": "invalid",
      "body": null
    },
    {
      "name": "malformed_invalid",
      "why": "Truncated JSON is not a body.",
      "input": "{\"a\":",
      "state": "invalid",
      "body": null
    },
    {
      "name": "field_name_invalid",
      "why": "A key outside the identifier shape is refused rather than normalised.",
      "input": "{\"a-b\":1}",
      "state": "invalid",
      "body": null
