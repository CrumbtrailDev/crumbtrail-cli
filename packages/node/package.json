{
  "name": "crumbtrail-node",
  "version": "0.46.0",
  "description": "Backend capture for Crumbtrail: crash and log capture, Express middleware, node:http request capture, database instrumentation, and Redis cache instrumentation. See https://crumbtrail.ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrumbtrailDev/crumbtrail-cli.git",
    "directory": "packages/node"
  },
  "keywords": [
    "crumbtrail",
    "debugging",
    "bug-reporting",
    "ai-agents",
    "coding-agent",
    "observability",
    "developer-tools",
    "express",
    "middleware",
    "database",
    "redis",
    "cache",
    "opentelemetry"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.15.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/assert-publish-safe.mjs",
    "prepublishOnly": "node ../../scripts/assert-publish-safe.mjs",
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "crumbtrail-core": "workspace:^",
    "node-sql-parser": "^5.4.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "express": "^5.2.1",
    "hono": "^4.13.3",
    "typescript": "^5.7.0"
  },
  "homepage": "https://crumbtrail.ai",
  "bugs": {
    "url": "https://github.com/CrumbtrailDev/crumbtrail-cli/issues"
  }
}
