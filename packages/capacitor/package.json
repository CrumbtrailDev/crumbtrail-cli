{
  "name": "crumbtrail-capacitor",
  "version": "0.34.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/assert-publish-safe.mjs",
    "prepublishOnly": "node ../../scripts/assert-publish-safe.mjs",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "crumbtrail-core": "workspace:^"
  },
  "peerDependencies": {
    "@capacitor/app": ">=5",
    "@capacitor/core": ">=5",
    "@capacitor/device": ">=5",
    "@capacitor/network": ">=5",
    "@capacitor/preferences": ">=5",
    "@capacitor/screen-orientation": ">=5"
  },
  "peerDependenciesMeta": {
    "@capacitor/app": {
      "optional": true
    },
    "@capacitor/device": {
      "optional": true
    },
    "@capacitor/network": {
      "optional": true
    },
    "@capacitor/preferences": {
      "optional": true
    },
    "@capacitor/screen-orientation": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "homepage": "https://crumbtrail.ai",
  "bugs": {
    "url": "https://github.com/CrumbtrailDev/crumbtrail-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrumbtrailDev/crumbtrail-cli.git",
    "directory": "packages/capacitor"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Capacitor and Ionic SDK for Crumbtrail: adds device, app lifecycle, connectivity and deep link context to the web capture already running in the WebView. See https://crumbtrail.ai",
  "keywords": [
    "crumbtrail",
    "debugging",
    "bug-reporting",
    "ai-agents",
    "coding-agent",
    "session-replay",
    "observability",
    "developer-tools",
    "capacitor",
    "ionic",
    "hybrid",
    "mobile",
    "ios",
    "android"
  ]
}
