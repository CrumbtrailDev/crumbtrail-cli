{
  "name": "crumbtrail",
  "version": "0.51.0",
  "description": "Set up Crumbtrail in one command: npx crumbtrail detects your framework, wires in the SDK and verifies the first event. Also the library the hosted product uses for detection and injection planning, on the crumbtrail/install and crumbtrail/testing subpaths. See https://crumbtrail.ai",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrumbtrailDev/crumbtrail-cli.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "crumbtrail",
    "debugging",
    "bug-reporting",
    "ai-agents",
    "coding-agent",
    "session-replay",
    "observability",
    "developer-tools",
    "cli",
    "setup",
    "wizard",
    "install",
    "codegen"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "crumbtrail": "./dist/cli.cjs"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./install": {
      "types": "./dist/install/index.d.ts",
      "import": "./dist/install/index.js",
      "require": "./dist/install/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/assert-publish-safe.mjs",
    "prepublishOnly": "node ../../scripts/assert-publish-safe.mjs",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "crumbtrail-core": "workspace:^",
    "crumbtrail-node": "workspace:^"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "entities": "6.0.1"
  },
  "homepage": "https://crumbtrail.ai",
  "bugs": {
    "url": "https://github.com/CrumbtrailDev/crumbtrail-cli/issues"
  }
}
